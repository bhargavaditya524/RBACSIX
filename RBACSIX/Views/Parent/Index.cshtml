@model RBACSIX.Models.ViewModels.ParentDashboardViewModel
@{
    ViewData["Title"] = "Parent dashboard";
}

<h1>Welcome, @Model.ParentName</h1>
<p class="text-muted">Read-only attendance, results, and fee information for linked students.</p>
@if (Model.Children.Count == 0)
{
    <div class="alert alert-info">No students are linked to your account. Contact the coaching center administrator.</div>
}
@foreach (var child in Model.Children)
{
    <section class="card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h4 mb-0">@child.StudentName</h2>
            <a class="btn btn-sm btn-outline-primary" asp-action="LeaveRequests" asp-route-studentProfileId="@child.StudentProfileId">Request or view leave</a>
        </div>
        <div class="card-body">
            @if (child.Batches.Count == 0)
            {
                <p class="text-muted mb-0">This student is not enrolled in a batch.</p>
            }
            @foreach (var batch in child.Batches)
            {
                <div class="border-bottom py-3">
                    <h3 class="h5">@batch.CourseName — @batch.BatchName</h3>
                    <p class="mb-1"><strong>Instructor:</strong> @(batch.StaffName ?? "To be assigned")</p>
                    <p class="mb-1"><strong>Attendance:</strong> @batch.PresentCount / @batch.AttendanceCount
                    @if (batch.AttendanceCount > 0)
                    {
                        <span>(@((batch.PresentCount * 100 / batch.AttendanceCount))%)</span>
                    }
                    </p>
                    <p class="mb-1"><strong>Fees:</strong> tuition @batch.TuitionFee.ToString("C"), charges @batch.MiscellaneousCharges.ToString("C"), paid @batch.Payments.ToString("C"), balance <strong>@batch.Balance.ToString("C")</strong></p>
                    <h4 class="h6 mt-3">Results</h4>
                    @if (batch.Results.Count == 0)
                    {
                        <p class="text-muted">No results recorded.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                        @foreach (var result in batch.Results)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span>@result.ExamName <small class="text-muted">@result.ExamDate.ToString("d")</small></span>
                                <strong>@result.MarksObtained / @result.MaxMarks</strong>
                            </li>
                        }
                        </ul>
                    }
                </div>
            }
        </div>
    </section>
}
