@{
    ViewData["Title"] = "Password reset";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1>Password reset</h1>
        <p>If the reset link was valid, your password has been changed. You can now sign in with your new password.</p>
        <a asp-action="Login" class="btn btn-primary">Sign in</a>
    </div>
</div>
