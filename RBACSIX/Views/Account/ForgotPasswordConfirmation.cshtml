@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1>Check your email</h1>
        <p>If an account matches that email address, password reset instructions will be sent when email delivery is available.</p>
        @if (ViewData["DevelopmentResetUrl"] is string resetUrl)
        {
            <p class="alert alert-warning">Development reset link: <a href="@resetUrl">Reset password</a></p>
        }
        <a asp-action="Login" class="btn btn-primary">Return to sign in</a>
    </div>
</div>
