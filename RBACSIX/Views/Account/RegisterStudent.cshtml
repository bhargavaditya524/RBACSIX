@model RBACSIX.Models.ViewModels.StudentRegistrationViewModel
@{
    ViewData["Title"] = "Student registration";
}

<h1>Create your Student account</h1>
<p class="text-muted">After registration you can sign in immediately and request enrollment in courses or batches.</p>
<form asp-action="RegisterStudent" method="post" class="col-lg-7 auth-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="GuardianName" class="form-label">Parent/guardian name (optional)</label><input asp-for="GuardianName" class="form-control" /><span asp-validation-for="GuardianName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Register and sign in</button>
    <a asp-action="Login" class="btn btn-link">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
