@model IEnumerable<RBACSIX.Models.ViewModels.PersonSummaryViewModel>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Students</h1>
    <a class="btn btn-primary" asp-action="CreateStudent">Add student</a>
</div>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Guardian</th><th></th></tr></thead>
        <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FullName</td>
                <td>@student.Email</td>
                <td>@student.PhoneNumber</td>
                <td>@student.Details</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Enrollments" asp-route-studentId="@student.ProfileId">Manage batches</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
