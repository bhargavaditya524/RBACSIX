@model RBACSIX.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<p class="eyebrow">ADMIN WORKSPACE</p>
<h1>Admin dashboard</h1>
<p class="text-muted">Manage coaching center accounts, courses, and batches.</p>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3"><section class="card metric-card metric-indigo"><div class="card-body"><div class="metric-label">Students</div><div class="display-6">@Model.StudentCount</div><div class="metric-caption">Registered learners</div></div></section></div>
    <div class="col-md-6 col-xl-3"><section class="card metric-card metric-blue"><div class="card-body"><div class="metric-label">Staff</div><div class="display-6">@Model.StaffCount</div><div class="metric-caption">Teaching team</div></div></section></div>
    <div class="col-md-6 col-xl-3"><section class="card metric-card metric-teal"><div class="card-body"><div class="metric-label">Courses</div><div class="display-6">@Model.CourseCount</div><div class="metric-caption">Learning programs</div></div></section></div>
    <div class="col-md-6 col-xl-3"><section class="card metric-card metric-amber"><div class="card-body"><div class="metric-label">Batches</div><div class="display-6">@Model.BatchCount</div><div class="metric-caption">Active cohorts</div></div></section></div>
</div>

<div class="dashboard-section-heading">
    <div>
        <h2 class="h4 mb-1">Quick actions</h2>
        <p class="text-muted mb-0">Manage people, programs, and daily operations.</p>
    </div>
</div>
<div class="d-flex flex-wrap gap-2 dashboard-actions">
    <a class="btn btn-primary" asp-action="CreateStudent">Add student</a>
    <a class="btn btn-outline-primary" asp-action="CreateStaff">Add staff</a>
    <a class="btn btn-outline-primary" asp-action="CreateCourse">Add course</a>
    <a class="btn btn-outline-primary" asp-action="CreateBatch">Add batch</a>
    <a class="btn btn-outline-primary" asp-action="CreateAdmin">Add administrator</a>
    <a class="btn btn-outline-secondary" asp-action="StaffApprovals">Staff approvals <span class="action-count">@Model.PendingStaffCount</span></a>
    <a class="btn btn-outline-secondary" asp-action="EnrollmentRequests">Enrollment requests <span class="action-count">@Model.PendingEnrollmentRequestCount</span></a>
    <a class="btn btn-outline-secondary" asp-action="ListRoles">Manage roles</a>
    <a class="btn btn-outline-dark" asp-controller="Reports" asp-action="Index">Reports</a>
</div>
