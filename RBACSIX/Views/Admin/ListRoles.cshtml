
@using Microsoft.AspNetCore.Identity
@using RBACSIX.Models
@model IEnumerable<IdentityRole>
@if (TempData["Message"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Message!</strong> @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
<div class="container">
<table>
    <thead>Roles</thead>
        @foreach(var role in Model)
        {
            <tr>
                <td class="px-3" >@role.NormalizedName</td>
               
                <td><a asp-action="Delete" class="btn btn-danger me-2" asp-route-id="@role.Id"> Delete </a></td>
                <td><button type="button" class="btn btn-warning">Update</button></td>

            </tr>
        }
       
    </table> <br /><br />
    <a asp-action="AddRoles" class="btn btn-primary">Add New Role</a>
</div>