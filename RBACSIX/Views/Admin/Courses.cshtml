@model IEnumerable<RBACSIX.Models.ViewModels.CourseViewModel>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Courses</h1>
    <a class="btn btn-primary" asp-action="CreateCourse">Add course</a>
</div>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Course</th><th>Description</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var course in Model)
        {
            <tr><td>@course.Name</td><td>@course.Description</td><td>@(course.IsActive ? "Active" : "Inactive")</td></tr>
        }
        </tbody>
    </table>
</div>
