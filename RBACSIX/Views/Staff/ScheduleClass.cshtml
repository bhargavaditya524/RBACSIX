@model RBACSIX.Models.ViewModels.CreateScheduledClassViewModel
@{
    ViewData["Title"] = "Create Zoom class";
}

<h1>Create Zoom class</h1>
<p class="text-muted">@Model.CourseName — @Model.BatchName</p>
<p>Times use the coaching center time zone: <strong>@Model.TimeZoneId</strong>. Enrolled students will see the class on their dashboards.</p>
<form asp-action="ScheduleClass" method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="BatchId" type="hidden" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label">Class title</label>
        <input asp-for="Title" class="form-control" maxlength="160" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-5 mb-3">
            <label asp-for="ClassDate" class="form-label">Date</label>
            <input asp-for="ClassDate" class="form-control" />
            <span asp-validation-for="ClassDate" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ClassTime" class="form-label">Start time</label>
            <input asp-for="ClassTime" class="form-control" />
            <span asp-validation-for="ClassTime" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="DurationMinutes" class="form-label">Minutes</label>
            <input asp-for="DurationMinutes" class="form-control" min="15" max="480" />
            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-success">Create Zoom Class</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

<hr />
<h2 class="h4">Classes for this batch</h2>
@if (Model.ScheduledClasses.Count == 0)
{
    <p class="text-muted">No Zoom classes have been scheduled yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Class</th><th>Starts</th><th>Duration</th><th>Meeting ID</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var scheduledClass in Model.ScheduledClasses)
            {
                <tr>
                    <td>@scheduledClass.Title</td>
                    <td>@scheduledClass.StartTimeLocal.ToString("f")</td>
                    <td>@scheduledClass.DurationMinutes min</td>
                    <td>@scheduledClass.ZoomMeetingId</td>
                    <td>@(scheduledClass.IsInProgress ? "In progress" : "Upcoming")</td>
                    <td>
                        @if (scheduledClass.CanDelete)
                        {
                            <form asp-action="DeleteScheduledClass" method="post">
                                <input type="hidden" name="id" value="@scheduledClass.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
